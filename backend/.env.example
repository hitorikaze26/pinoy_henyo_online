# ============================================================
# Pinoy Henyo Online — Environment Configuration
# ============================================================
# Copy this file to backend/.env and fill in the values.
# backend/.env is gitignored — never commit real credentials.

# --- Deployment mode -------------------------------------------------------
# DEPLOY_MODE explicitly selects how the app behaves:
#   local  - host laptop only (http://localhost:5000, http://127.0.0.1:5000)
#   lan    - host laptop + phones on the same Wi-Fi/hotspot
#   online - deployed behind Cloudflare/reverse proxy (HTTPS public hostname)
# Omit it and DEPLOY_MODE is derived from FLASK_CONFIG (production -> online,
# anything else -> local).
FLASK_CONFIG=development
DEPLOY_MODE=local

# --- Core ------------------------------------------------------------------
# SECRET_KEY: leave empty in development for a random per-run key.
# REQUIRED (non-empty) for FLASK_CONFIG=production.
SECRET_KEY=

# Local/LAN default:
#   DATABASE_URL=mysql+pymysql://root:<password>@localhost/pinoy_henyo_db
# Online example (Supabase PostgreSQL):
#   DATABASE_URL=postgresql+psycopg2://<user>:<pass>@<host>:5432/<db>
DATABASE_URL=

# Comma-separated allowed browser origins. Empty means:
#   development/LAN: any origin allowed (phones on the LAN connect fine)
#   production:      none allowed (cross-origin REST + Socket.IO are refused)
# Online example: CORS_ORIGINS=https://game.example.com
CORS_ORIGINS=

PORT=5000

# --- QR codes --------------------------------------------------------------
# Where players land after scanning a QR code.
#   local/lan: leave empty -> QR uses the origin the request arrived on
#              (e.g. http://192.168.1.100:5000 works for phones on the LAN)
#   online:    set to the public hostname, e.g. QR_BASE_URL=https://game.example.com
QR_BASE_URL=

# --- Maintenance / timeouts -------------------------------------------------
# Games whose host is inactive longer than this are marked EXPIRED.
# Set to 0 to disable (handy for long local/LAN sessions).
HOST_INACTIVITY_TIMEOUT=900

# Device heartbeat interval (seconds). Phones that stop heartbeating past
# DEVICE_HEARTBEAT_TIMEOUT * DEVICE_HEARTBEAT_GRACE_MULTIPLIER are cleaned up.
DEVICE_HEARTBEAT_TIMEOUT=60

# Grace multiplier for mobile browser backgrounding / screen lock.
# Effective stale threshold = 60 * 3 = 180 seconds before a device is dropped.
DEVICE_HEARTBEAT_GRACE_MULTIPLIER=3

# How often the background maintenance sweeper runs (seconds).
SWEEPER_INTERVAL=30

# --- Rate limiting ----------------------------------------------------------
# Scales per-IP rate limits for gameplay endpoints. Production keeps 1;
# local/LAN can raise it (e.g. 5) so a phone hotspot (shared IP) is not
# throttled during normal play.
RATE_LIMIT_MULTIPLIER=1

# --- AI word generator (Google Gemini) --------------------------------------
# Backend-only key; never exposed to the frontend. Leave empty to disable the
# AI word generator (the button is hidden on the client).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Which Gemini model to use for word suggestions.
GEMINI_MODEL=gemini-2.0-flash
# Max words a single generation request may ask for (1..AI_MAX_WORDS_PER_REQUEST).
AI_MAX_WORDS_PER_REQUEST=20
# Min seconds between AI requests from the same game+actor (per-process).
AI_REQUEST_COOLDOWN_SECONDS=5
# Per-IP rate limit for the AI generate endpoint (window = 60s).
AI_MAX_REQUESTS_PER_MINUTE=5

# --- Werkzeug / dev server --------------------------------------------------
# Reloader is useful on localhost but undesirable for LAN/online deployments.
WERKZEUG_RELOADER=true

# ============================================================
# Production deployment (Render / Fly / any host)
# ============================================================
# Set these in the deployment environment, NOT in a committed file.
#
#   FLASK_CONFIG=production
#   DEPLOY_MODE=online
#   SECRET_KEY=<long random string>                         (required)
#   DATABASE_URL=postgresql+psycopg2://<user>:<pass>@<host>:5432/<db>
#   CORS_ORIGINS=https://<your-frontend-domain>
#   QR_BASE_URL=https://<your-frontend-domain>
#   WERKZEUG_RELOADER=false
#
# Render build command:  pip install -r requirements-render.txt
# Render start command:  flask db upgrade && python run.py