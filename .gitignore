*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ---- Virtual environments ----
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ---- Environment & secrets ----
# Copy backend/.env.example to backend/.env and fill in real values.
# The real .env (with DATABASE_URL / SECRET_KEY) must NEVER be committed.
.env
.env.local
.env.*.local
*.pem

# ---- Test / coverage / cache ----
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.cache/
.tmp/
*,cover

# ---- Generated audit / report artifacts ----
CONNECTION_AUDIT_REPORT.md
FINAL_E2E_REPORT.md

# ---- OS ----
.DS_Store
Thumbs.db
Desktop.ini

# ---- Editors / IDEs ----
.vscode/
.idea/
*.swp
*.swo
*~
