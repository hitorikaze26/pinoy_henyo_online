# Flask configuration profile: development | testing | production
FLASK_CONFIG=development
SECRET_KEY=
DATABASE_URL=
CORS_ORIGINS=
PORT=5000

# --- Production deployment (Render + Supabase + Vercel) ------------------
# Set these in the Render dashboard environment, NOT in a committed file.
#
#   FLASK_CONFIG=production
#   SECRET_KEY=<long random string>                         (required)
#   DATABASE_URL=postgresql+psycopg2://<user>:<pass>@<host>:5432/<db>
#   CORS_ORIGINS=https://<vercel-app>.vercel.app            (no wildcard;
#                            comma-separate multiple origins if needed)
#   QR_BASE_URL=https://<vercel-app>.vercel.app
#   PORT                                                   (Render injects)
#
# Render build command:  pip install -r requirements-render.txt
# Render start command:  flask db upgrade && gunicorn -k eventlet -w 1 \
#                        run:gunicorn_app

# --- Supabase (backend-only) ----------------------------------------------
# DATABASE_URL above is the Supabase PostgreSQL connection string
# (postgresql+psycopg2://...). The keys below are NOT used yet: the app has
# no storage/upload feature, so nothing reads them — add them when Supabase
# Storage or Realtime is integrated.
#
#   SUPABASE_URL=<project-url>
#   SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
#
# SECURITY: privileged Supabase credentials (service-role key) must live ONLY
# in the backend environment. NEVER expose them to frontend JavaScript or put
# them in frontend/js/core/runtime-config.js.